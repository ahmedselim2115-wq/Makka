generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id             String   @id @default(cuid())
  name           String
  nameEn         String?
  description    String
  descriptionEn  String?
  price          Float
  compareAtPrice Float?
  imageUrl       String
  category       String   @default("ثلاجات")
  categoryEn     String?
  capacity       String?
  capacityEn     String?
  temperature    String?
  temperatureEn  String?
  power          String?
  powerEn        String?
  featured       Boolean  @default(false)
  inStock        Boolean  @default(true)
  showPrice      Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  orders         Order[]
  ratings        Rating[]
}

model SiteSettings {
  id                         String   @id @default(cuid())
  heroTitle                  String   @default("مصنع مكة للثلاجات")
  heroTitleEn                String?
  heroSubtitle               String   @default(" التبريد الحديثة")
  heroSubtitleEn             String?
  heroImage                  String   @default("")
  heroImages                 String?
  aboutTitle                 String   @default("من نحن")
  aboutTitleEn               String?
  aboutText                  String   @default("مصنع مكة للثلاجات هو مصنع رائد في تصنيع الثلاجات التجارية والصناعية")
  aboutTextEn                String?
  aboutImage                 String   @default("")
  aboutVideo                 String?
  aboutHeadingHighlight      String   @default("مصنع متكامل")
  aboutHeadingHighlightEn    String?
  aboutHeadingRest           String   @default("لتصنيع حلول التبريد")
  aboutHeadingRestEn         String?
  aboutPoints                String?
  aboutPointsEn              String?
  aboutStats                 String?
  aboutStatsEn               String?
  productsBadge              String   @default("منتجاتنا")
  productsBadgeEn            String?
  productsHeadingRest        String   @default("تشكيلتنا من")
  productsHeadingRestEn      String?
  productsHeadingHighlight   String   @default("الثلاجات والفريزرات")
  productsHeadingHighlightEn String?
  productsText               String?
  productsTextEn             String?
  phone                      String   @default("")
  email                      String   @default("")
  address                    String   @default("")
  workingHours               String   @default("السبت - الخميس: 9 صباحاً - 6 مساءً")
  workingHoursEn             String?
  facebook                   String   @default("")
  instagram                  String   @default("")
  tiktok                     String   @default("")
  telegram                   String   @default("")
  whatsapp                   String   @default("")
  whatsappWidgetEnabled      Boolean  @default(true)
  whatsappWelcomeMessage     String   @default("مرحباً بك! كيف يمكننا مساعدتك اليوم؟")
  whatsappWelcomeMessageEn   String?
  mapLocation                String?
  showcaseTitle              String   @default("استكشف منتجاتنا")
  showcaseTitleEn            String?
  showcaseSubtitle           String   @default("تنقل بين المنتجات، وحرّك الماوس لاستكشاف التفاصيل عن قرب")
  showcaseSubtitleEn         String?
  adminPassword              String   @default("admin123")
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  nameEn    String?
  createdAt DateTime @default(now())
}

model User {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  password     String
  isActive     Boolean      @default(true)
  isSuperAdmin Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  permissions  Permission[]
}

model Permission {
  id     String @id @default(cuid())
  userId String
  key    String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

model ShowcaseProduct {
  id        String            @id @default(cuid())
  name      String
  nameEn    String?
  image     String
  order     Int               @default(0)
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  hotspots  ShowcaseHotspot[]

  @@map("showcase_products")
}

model ShowcaseHotspot {
  id                String          @id @default(cuid())
  showcaseProductId String
  title             String
  titleEn           String?
  description       String
  descriptionEn     String?
  icon              String?
  positionX         Float
  positionY         Float
  order             Int             @default(0)
  showcaseProduct   ShowcaseProduct @relation(fields: [showcaseProductId], references: [id], onDelete: Cascade)

  @@map("showcase_hotspots")
}

model Order {
  id           String   @id @default(cuid())
  productId    String?
  productName  String
  customerName String
  phone        String
  address      String
  notes        String?
  status       String   @default("جديد")
  source       String   @default("website")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  product      Product? @relation(fields: [productId], references: [id])

  @@map("orders")
}

model Rating {
  id           String   @id @default(cuid())
  productId    String?
  productName  String
  customerName String
  phone        String
  value        Int
  comment      String?
  status       String   @default("pending")
  createdAt    DateTime @default(now())
  product      Product? @relation(fields: [productId], references: [id])

  @@map("ratings")
}
